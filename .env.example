# ======================= THE ONE SWITCH =======================
# OPENROUTER=true  -> cheap cloud model via OpenRouter (fast: many PDFs/calls in parallel)
# OPENROUTER=false -> local model via Ollama on this machine (free, slow: one GPU)
# Leave it unset to configure provider/model/base URL by hand (the settings further below).
OPENROUTER=false

# --- when OPENROUTER=true ---
OPENROUTER_API_KEY=
# any image-capable model on openrouter.ai; qwen/qwen3.7-flash is ~$3 per 400 PDFs
OPENROUTER_MODEL=qwen/qwen3.7-flash

# --- when OPENROUTER=false ---
OLLAMA_MODEL=qwen3-vl:8b-instruct
# OLLAMA_URL=http://localhost:11434/v1
# To let Ollama answer N requests at once (needs RAM; little speed-up on one GPU):
# start Ollama with OLLAMA_NUM_PARALLEL=N and set the same value here.
# OLLAMA_NUM_PARALLEL=1

# The switch sets OCR_PDF_CONCURRENCY / OCR_CONCURRENCY / OCR_ESCALATION_BATCH /
# OCR_REQUEST_TIMEOUT_MS to sensible values per mode; any of them set below still wins.
# ===============================================================

# ---- Vision model provider (pick one) ----
# claude | openai | gemini   (mock = offline synthetic output, for testing the plumbing only)
OCR_PROVIDER=claude
# Model id for the chosen provider. Defaults: claude-opus-5-5 / gpt-4o / gemini-2.5-pro
# OCR_MODEL=claude-opus-5-5

ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# The openai provider also talks to any OpenAI-compatible server:
#   OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1  OCR_MODEL=google/gemini-2.5-flash-lite
#   Ollama:     OPENAI_BASE_URL=http://localhost:11434/v1      OCR_MODEL=llama3.2-vision:latest  OPENAI_API_KEY=ollama
#               (local models: OCR_CONCURRENCY=1 OCR_PDF_CONCURRENCY=1 OCR_ESCALATION_BATCH=1 OCR_REQUEST_TIMEOUT_MS=600000)
# OPENAI_BASE_URL=
# Per-request timeout in ms (raise for slow local models)
# OCR_REQUEST_TIMEOUT_MS=180000

# Claude only: reasoning effort for OCR calls (low|medium|high). low is plenty for OCR.
OCR_EFFORT=low

# ---- Engine ----
# local  = (default) tesseract + algorithms only: multi-pass voting, digit/EPIC re-reads,
#          name consensus, local transliteration. NO model, NO API key, nothing leaves the box.
#          Uncertain cards are flagged in _flag_reason for a human instead of being re-read.
# hybrid = like local, but cards tesseract is unsure about are re-read by a vision model
#          (needs OPENROUTER=true or a provider key below).
# llm    = the model reads every page (highest cost). Names are local in every engine.
OCR_ENGINE=local
# Cover page (page 1): always parsed from its tesseract text. true = also send that text to the
# model (text only, no image) for the assembly name/no and part no. Default: same as OPENROUTER.
# OCR_COVER_LLM=true
# Where model.json / overrides.tsv / seed TSVs live (default ./data/translit)
# OCR_TRANSLIT_DIR=./data/translit
# hybrid: tesseract word confidence (0..1) below which a card is sent to the model.
# Lower = cheaper but more local misreads slip through; 0.85 is a good default for clean print.
OCR_LOCAL_MIN_CONF=0.85
# hybrid: escalated card images per model call
OCR_ESCALATION_BATCH=10
# Path to the tesseract binary if not on PATH
# TESSERACT_CMD=/usr/bin/tesseract

# ---- Pipeline tuning (all optional) ----
# Render DPI (default 300 for hybrid - tesseract needs it for EPIC digits; 200 for llm)
# OCR_DPI=300
# Max PDFs processed at once (keep <=2 on a 2 vCPU / 4 GB box)
OCR_PDF_CONCURRENCY=2
# Pages OCR'd at once across all PDFs (each is ~1 core of tesseract). Default: CPU cores.
# OCR_PAGE_CONCURRENCY=8
# Cross-PDF Hindi name memory (data/learned/hi-names.json). false = neither read nor update it.
# OCR_NAME_MEMORY=true
# Max simultaneous model API calls (global, across all PDFs)
OCR_CONCURRENCY=4
# Rows below this model-reported confidence get _flag_reason=low_confidence
OCR_CONFIDENCE_THRESHOLD=0.7
# strip | page | card   (strip = a few grid rows per call; best accuracy/cost balance)
OCR_MODE=strip
# Where per-PDF JSON results are cached (resume support)
OCR_CACHE_DIR=./cache
# Where rendered page images go while a PDF is being processed (cleaned up per PDF)
OCR_TMP_DIR=./tmp
