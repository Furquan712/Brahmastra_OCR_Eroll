{
  "name": "eroll-ocr",
  "version": "0.1.0",
  "description": "Batch OCR pipeline: scanned ECI electoral-roll PDFs -> upload-ready CSV (with Devanagari transliteration)",
  "type": "module",
  "private": true,
  "bin": { "eroll-ocr": "dist/cli.js" },
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts",
    "translit": "tsx src/cli.ts translit",
    "translit:train": "tsx src/cli.ts translit-train",
    "translit:eval": "tsx src/cli.ts translit-eval"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@google/genai": "^2.28.0",
    "commander": "^15.0.0",
    "openai": "^7.32.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
