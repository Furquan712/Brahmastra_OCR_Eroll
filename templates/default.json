{
  "name": "default",
  "description": "ECI Hindi eRoll (iText generated), A4, 3 columns x 10 rows of bordered voter cards per page. Used for UP/Bihar/MP/Rajasthan/Delhi style rolls.",
  "match": { "states": [] },
  "language": "Hindi (Devanagari script)",
  "script": "devanagari",
  "grid": { "cols": 3, "rows": 10 },
  "strips": { "rowsPerStrip": 2, "padPx": 6 },
  "fallbackBody": { "top": 0.034, "bottom": 0.962, "left": 0.02, "right": 0.98 },
  "detection": { "minLineFraction": 0.5 },
  "classify": { "longEdgePx": 1200 },
  "local": {
    "langs": "eng+hin",
    "headerFraction": 0.045,
    "epicBox":   { "left": 0.38, "top": 0.0,  "width": 0.62, "height": 0.22 },
    "serialBox": { "left": 0.03, "top": 0.04, "width": 0.29, "height": 0.12 },
    "sectionBox": { "left": 0.3, "top": 0.03, "width": 0.28, "height": 0.14 },
    "bodyBox":   { "left": 0.0,  "top": 0.2,  "width": 0.66, "height": 0.8 }
  },
  "labels": {
    "serial": ["क्रम संख्या"],
