    "other": ["अन्य"],
    "house": ["मकान संख्या", "गृह संख्या"],
    "houseLoose": ["संख्या", "सकान"],
    "age": ["आयु", "उम्र"],
    "gender": ["लिंग"],
    "partNo": ["भाग संख्या"],
    "sectionNoName": ["अनुभाग संख्या और नाम", "अनुभाग संख्या व नाम"],
    "photoPlaceholder": ["फोटो उपलब्ध है", "फोटो उपलब्ध नहीं है"]
  },
  "relationMap": {
    "पिता": "Father",
